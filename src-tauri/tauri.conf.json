{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mintask",
  "version": "0.1.0",
  "identifier": "xyz.devkrish.mintask",
  "build": {
    "devUrl": "https://mintask.vercel.app",
    "frontendDist": "https://mintask.vercel.app"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "mintask",
        "width": 1280,
        "height": 840,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
